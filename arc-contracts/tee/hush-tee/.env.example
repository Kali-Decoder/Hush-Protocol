# Hush TEE Extension — Flare Coston2
#
#   cp .env.example .env
#   # fill PRIVATE_KEY + INITIAL_OWNER
#   ./scripts/pre-build.sh       # deploys + registers extension
#   ./scripts/start-services.sh  # docker compose up
#   ./scripts/post-build.sh      # registers TEE machine on-chain

# Extension language (TypeScript for Hush)
LANGUAGE=typescript

# ─── Wallet ──────────────────────────────────────────────────────────
# Funded Coston2 private key (hex, no 0x prefix)
# From: https://faucet.flare.network/coston2
PRIVATE_KEY="<your-funded-coston2-private-key>"

# Address derived from PRIVATE_KEY
INITIAL_OWNER="0x<your-address>"

# ─── On-chain addresses (filled by pre-build.sh) ─────────────────────
INSTRUCTION_SENDER="0x<deployed-address>"
EXTENSION_ID="0x<64-hex-chars>"

# ─── Proxy & tunnel ──────────────────────────────────────────────────
# Public HTTPS tunnel to host port 6674
#   cloudflared tunnel --url http://localhost:6674
#   ngrok http 6674
EXT_PROXY_URL="https://<your-tunnel-domain>"
TUNNEL_URL="https://<your-tunnel-domain>"

# API key for POST /direct (optional, enables direct extension calls)
DIRECT_API_KEY="<generate-a-random-string>"

# ─── Chain ───────────────────────────────────────────────────────────
CHAIN_ID=114
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
FEE_WEI=1000000000000
LOCAL_MODE=false
SIMULATED_TEE=true

# ─── Paths ───────────────────────────────────────────────────────────
# Relative to hush-tee/ root
ADDRESSES_FILE=config/coston2/deployed-addresses.json
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# ─── Docker build branches ──────────────────────────────────────────
TEE_NODE_VERSION=develop
TEE_PROXY_VERSION=develop

# ─── Governance (optional, defaults to INITIAL_OWNER, threshold 1) ──
# GOVERNANCE_SIGNERS="0xAbc..."
# GOVERNANCE_THRESHOLD=1

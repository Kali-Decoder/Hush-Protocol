# Deployer key (required for remote networks)
PRIVATE_KEY=

# ── Flare Coston2 Testnet (primary) ──────────────────────────────────────────
# Network: Flare Testnet Coston2 · Chain ID: 114 · Currency: C2FLR
# Explorer: https://coston2-explorer.flare.network
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_API_KEY=

# ── Flare Mainnet ────────────────────────────────────────────────────────────
# Network: Flare Mainnet · Chain ID: 14 · Currency: FLR
# Explorer: https://flare-explorer.flare.network
FLARE_MAINNET_RPC_URL=https://flare-api.flare.network/ext/C/rpc
FLARE_API_KEY=

# ══ TEE / FCC (Flare Confidential Compute) ═════════════════════════════════
# Coston2 FCC system contracts:
#   TeeExtensionRegistry: 0x3d478d43426081BD5854be9C7c5c183bfe76C981
#   TeeMachineRegistry:   0x5918Cd58e5caf755b8584649Aa24077822F87613
TEE_EXTENSION_REGISTRY=0x3d478d43426081BD5854be9C7c5c183bfe76C981
TEE_MACHINE_REGISTRY=0x5918Cd58e5caf755b8584649Aa24077822F87613

# Who owns MerkleRootManager / can postRoot (defaults to deployer)
RELAYER_ADDRESS=

# Token / mint knobs used by deploy scripts
MINT_TO=
MINT_AMOUNT=1000000
SKIP_TOKEN=
SKIP_MINT=
ADD_TO_POOL=1

# Per-script overrides (defaults match deployments/coston2.json)
POOL_ADDRESS=
TOKEN_ADDRESS=
TOKEN_DECIMALS=
TOKEN_SYMBOL=
ROOT=
ROOT_MANAGER_ADDRESS=
ACTION=

# ── Indexer (see indexer/.env.example) ───────────────────────────────────────
# BULLET_POOL_ADDRESS=
# MERKLE_ROOT_MANAGER_ADDRESS=
# RELAYER_PRIVATE_KEY=
# DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/hushh_indexer?retryWrites=true&w=majority
# CONFIRMATIONS=8
# API_PORT=4010

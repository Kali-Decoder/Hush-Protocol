{
  "name": "@hush/contracts",
  "private": true,
  "version": "0.1.0",
  "description": "Hush ZK payment pool — Solidity on Flare Network",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",

    "deploy": "hardhat run scripts/deploy/deploy-all.ts --network coston2",
    "deploy:all": "hardhat run scripts/deploy/deploy-all.ts --network coston2",
    "deploy:coston2": "hardhat run scripts/deploy/deploy-all.ts --network coston2",
    "deploy:flare": "hardhat run scripts/deploy/deploy-all.ts --network flare",
    "deploy:local": "hardhat run scripts/deploy/deploy-all.ts --network localhost",
    "deploy:tee": "hardhat run scripts/deploy/deploy-tee.ts --network coston2",
    "deploy:tee:flare": "hardhat run scripts/deploy/deploy-tee.ts --network flare",
    "deploy:token": "hardhat run scripts/deploy/deploy-token.ts --network coston2",
    "add:token": "hardhat run scripts/deploy/add-token.ts --network coston2",
    "remove:token": "hardhat run scripts/deploy/remove-token.ts --network coston2",
    "mint:token": "hardhat run scripts/deploy/mint-token.ts --network coston2",
    "smoke": "hardhat run scripts/deploy/smoke.ts --network coston2",

    "post:root": "hardhat run scripts/ops/post-root.ts --network coston2",
    "pool:pause": "ACTION=pause hardhat run scripts/ops/pause.ts --network coston2",
    "pool:unpause": "ACTION=unpause hardhat run scripts/ops/pause.ts --network coston2",
    "status": "hardhat run scripts/ops/status.ts --network coston2",
    "verify": "hardhat verify --network coston2",
    "verify:all": "hardhat run scripts/deploy/verify-all.ts --network coston2",

    "zk:install": "pnpm --dir zk install --ignore-workspace",
    "zk:build": "pnpm --dir zk run build",
    "sdk:install": "pnpm --dir sdk install --ignore-workspace",
    "sdk:build": "pnpm --dir sdk run build",
    "sdk:test": "pnpm --dir sdk run test",
    "indexer:install": "pnpm --dir indexer install --ignore-workspace",
    "indexer:dev": "pnpm --dir indexer dev",
    "indexer:migrate": "pnpm --dir indexer db:migrate",
    "indexer:test": "pnpm --dir indexer exec node --import tsx --test src/**/*.test.ts",
    "backend:install": "pnpm --dir backend install --ignore-workspace",
    "backend:dev": "pnpm --dir backend dev",
    "backend:db": "pnpm --dir backend db:generate && pnpm --dir backend db:push"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.21",
    "chai": "^4.5.0",
    "dotenv": "^16.0.0",
    "ethers": "^6.14.0",
    "hardhat": "^2.28.4",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
